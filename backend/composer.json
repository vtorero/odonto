{
  "name": "odontodesa/slim4-api",
  "description": "API RESTful en Slim 4 y MySQL para Sistema Odontológico ODONTODESA",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6",
    "vlucas/phpdotenv": "^5.5",
    "firebase/php-jwt": "^6.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "scripts": {
    "start": "php -S 0.0.0.0:8080 -t public"
  }
}
